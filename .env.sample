# Sample environment file.
#
# The API does **not** read `.env` itself. `docker compose` only interpolates the variables that
# docker-compose.yml references with `${...}` — for this repository that is `LBHPACKAGESTOKEN` (plus
# `SONAR_TOKEN` for the test image). The variable under "Runtime" below is read by the API from its process
# environment and is **not** picked up from this file; docker-compose.yml hardcodes its own value for the
# container. Export it (or add it to the compose service) if you need to override it.

# --- Build (read from .env by docker compose) --------------------------------
# Personal access token with read:packages on the LBHackney-IT GitHub Packages feed.
# Required by `docker compose build` (the Hackney.* packages are not on nuget.org).
LBHPACKAGESTOKEN=your-github-personal-access-token-here

# --- Runtime (NOT read from .env — export these) ------------------------------
# The compose stack supplies http://reference-data-elasticsearch:9200 to the container.
# Defaults to http://localhost:9200 when unset; appsettings.LocalDevelopment.json uses port 9202.
# Note the exact casing — the configuration key is `ElasticSearchDomainUrl`.
ElasticSearchDomainUrl=http://localhost:9200
